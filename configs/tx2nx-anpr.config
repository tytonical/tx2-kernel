# TX2 NX (T186) ANPR kernel config fragment.
# Applied on top of arch/arm64/configs/tegra_defconfig with
# scripts/kconfig/merge_config.sh (see scripts/build-kernel.sh).
#
# Keep explicitly (do not trim without hardware proof): all NVIDIA drivers
# (nvgpu, nvmap, nvhost, VI/NVCSI/RTCPU), V4L2/media core used by the Basler
# MIPI driver, STAGING (CONFIG_SYNC lives there and nvgpu uses it), EQOS,
# xHCI/XUSB PHY (Basler USB3 camera via usbfs), TUN, PPP, iptables legacy,
# ZRAM, BINFMT_MISC, USERSPACE_THERM_ALERT.

#
# A. Additions required by the A/B design
#
CONFIG_DM_VERITY=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

#
# B. Hardware the TX2 NX does not have / features ruled out by the design
#
# Other Jetson SoCs (ARCH_TEGRA_210/19x/23x_SOC) are deliberately left enabled:
# NVIDIA's drivers are only built and tested with them on (nvhost fails to link
# without T19x), and the shipped R32.7.6 kernel has them all enabled.
# InfiniBand / RDMA, IrDA
# CONFIG_INFINIBAND is not set
# CONFIG_IRDA is not set
# Network filesystems
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NET_9P is not set
# Unused local filesystems (ext4 still mounts ext2/ext3)
# CONFIG_BTRFS_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_FAT_FS is not set
# Storage other than eMMC: SCSI (incl. SAS, UFS, USB storage), SATA, NVMe, MTD/QSPI
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MTD is not set
# Android (binder, ashmem, LMK); STAGING stays for CONFIG_SYNC
# CONFIG_ANDROID is not set
# NVIDIA tegracam sensor-DT self-test module (not loaded in production; needs
# glob_match(), whose only selector here was libata)
# CONFIG_VIDEO_CAMERA_SKT is not set
# Debug / attack surface
# CONFIG_KEXEC is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEVKMEM is not set

#
# C. Peripherals not fitted
#
# PCI stays enabled: nothing is on the bus, but NET_VENDOR_NVIDIA depends on
# PCI and gates the Makefile path to the (platform) EQOS Ethernet driver.
# Wi-Fi (cfg80211/mac80211, in-tree, NVIDIA out-of-tree and staging drivers)
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BCMDHD is not set
# CONFIG_RTL8812AU is not set
# CONFIG_RTL8814AU is not set
# CONFIG_RTL8821AU is not set
# CONFIG_RTL8821CU is not set
# CONFIG_RTL8822BU is not set
# CONFIG_RTL8822CE is not set
# CONFIG_R8188EU is not set
# CONFIG_R8712U is not set
# CONFIG_RTL8192E is not set
# CONFIG_RTL8192U is not set
# CONFIG_RTLLIB is not set
# CONFIG_PRISM2_USB is not set
# Bluetooth
# CONFIG_BT is not set
# CONFIG_RTK_BTUSB is not set
# CAN
# CONFIG_CAN is not set
# CONFIG_MTTCAN is not set
# Sound
# CONFIG_SOUND is not set
# Display: serial console only (HDMI debug use not required)
# CONFIG_TEGRA_DC is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_LOGO is not set
# No panel, so no backlight (NVIDIA dc.h's !TEGRA_DC stubs are non-inline and
# collide at link time when two backlight drivers include it)
# CONFIG_BACKLIGHT_LCD_SUPPORT is not set
# CONFIG_USB_APPLEDISPLAY is not set
# HID: keep generic + USB HID for a bench keyboard
# CONFIG_HID_ACRUX is not set
# CONFIG_HID_APPLE is not set
